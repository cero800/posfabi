{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tienda",
  "version": "1.0.17",
  "identifier": "com.tienda.pos",
  "build": {
    "beforeDevCommand": "pnpm --filter @tienda/desktop dev",
    "devUrl": "http://localhost:3001",
    "beforeBuildCommand": "pnpm --filter @tienda/desktop build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tienda",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src ipc: http://ipc.localhost http://tauri.localhost ws://tauri.localhost http://localhost:3000 ws://localhost:3000 http://localhost:3001 ws://localhost:3001"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": ["binaries/tienda-db"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      }
    }
  }
}
