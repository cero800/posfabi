{
  "name": "tienda-pos",
  "private": true,
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev:desktop": "pnpm --filter @tienda/desktop dev",
    "build:core": "pnpm --filter @tienda/core build",
    "build:desktop": "pnpm --filter @tienda/desktop build",
    "build:backend": "pnpm --filter @tienda/db build",
    "build:sea": "pnpm --filter @tienda/db build:sea",
    "typecheck": "pnpm --filter @tienda/core build && pnpm --filter @tienda/db typecheck && pnpm --filter @tienda/desktop exec tsc --noEmit",
    "test": "pnpm --filter @tienda/db test && pnpm --filter @tienda/desktop test",
    "clean": "pnpm -r exec rm -rf node_modules dist build .turbo"
  },
  "devDependencies": {
    "typescript": "^5.2.2"
  }
}
